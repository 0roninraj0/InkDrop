{
  "name": "inkdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "InkDrop - offline premium comic reader (cbz, cbr, zip, pdf)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
