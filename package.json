    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@preact/preset-vite": "^2.10.6",
    "vite": "^8.3.5"
  }
